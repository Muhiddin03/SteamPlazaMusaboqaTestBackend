# ─── MAJBURIY ────────────────────────────────────────────────────────────────
# Railway PostgreSQL URL (Railway o'zi ulaydi: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://username:password@host:port/dbname

# Admin tokenlarini imzolash uchun maxfiy kalit (kamida 32 belgi).
# Yaratish:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Birinchi ishga tushganda yaratiladigan admin.
# Parol: kamida 10 belgi, harf + raqam. Kirgandan keyin Sozlamalar'dan o'zgartiring.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Frontend manzili (vergul bilan bir nechta). Faqat shu saytlardan API'ga ruxsat.
ALLOWED_ORIGINS=https://sizning-sayt.vercel.app

# ─── IXTIYORIY ───────────────────────────────────────────────────────────────
NODE_ENV=production
# Railway PORT'ni o'zi beradi
PORT=3000

# Parolni unutsangiz: true qiling -> admin paroli ADMIN_PASSWORD ga qaytadi.
# Kirib bo'lgach bu o'zgaruvchini O'CHIRING.
ADMIN_RESET_PASSWORD=false
